# LLM Configuration (Ollama - local, free)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=300

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=parking_docs

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=parking_booking
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking_secret

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Guardrails
GUARDRAILS_ENABLED=true

# MCP Server
MCP_BASE_URL=http://localhost:8001
MCP_API_TOKEN=mcp-secret-token
MCP_OUTPUT_FILE=/data/approved_reservations.txt
